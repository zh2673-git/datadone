        "config_auto_reload": true,
        "config_reload_interval": 60,
        "cache_enabled": true,
        "cache_timeout": 86400,
        "cache_dir": "cache"
    },
    "output": {
        "excel": {
            "default_dir": "output",
            "max_rows_per_sheet": 1000000
        },
        "word": {
            "default_dir": "output",
            "max_rows_per_table": 20,
            "chart_width": 6,
            "chart_height": 4
        }
    },
